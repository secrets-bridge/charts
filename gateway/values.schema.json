{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "secrets-bridge-gateway values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commonLabels": {
          "type": "object"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "allowMutableTag": {
          "type": "boolean"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "insecureTransport": {
      "type": "boolean"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "shutdownGrace": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "localPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "cp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "caExistingSecret": {
          "type": "string"
        },
        "caExistingSecretKey": {
          "type": "string"
        },
        "tlsServerName": {
          "type": "string"
        },
        "heartbeatInterval": {
          "type": "string"
        },
        "claimInterval": {
          "type": "string"
        },
        "claimIdleMax": {
          "type": "string"
        },
        "claimConcurrency": {
          "type": [
            "string",
            "integer"
          ]
        },
        "leaseMargin": {
          "type": "string"
        },
        "passTimeout": {
          "type": "string"
        },
        "unreachableAfter": {
          "type": "string"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Release 1: argocd only. The eso and rollout kinds are not supported by this chart.",
      "properties": {
        "argocd": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "baseURL",
              "tokenSecret",
              "allowedProjects",
              "applications"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "baseURL": {
                "type": "string"
              },
              "tokenSecret": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                }
              },
              "caSecret": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                }
              },
              "tlsServerName": {
                "type": "string"
              },
              "timeout": {
                "type": "string"
              },
              "allowedProjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "applications": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "appNamespace": {
                      "type": "string"
                    }
                  }
                }
              },
              "egress": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidrs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "namespaceSelector": {
                    "type": "object"
                  },
                  "podSelector": {
                    "type": "object"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readinessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
